{
  "expo": {
    "name": "MedClip-pipeline",
    "slug": "MedClip-pipeline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#f2ede4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medclip.pipeline"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f2ede4"
      },
      "package": "com.medclip.pipeline"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": []
  }
}
